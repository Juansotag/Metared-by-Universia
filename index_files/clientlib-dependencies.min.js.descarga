  :host {
    display: block;
    width: 100%;
    border-radius: 2px;
    height: 100%;
  }

  * {
    margin: 0;
    padding: 0;
  }

  .alfred-card-container {
    display: flex;
    align-items: center;
    box-shadow: 0px 0px 32px 0px rgba(206, 222, 231, 0.4);
    cursor: pointer;
    height: 100%;
    border-radius: 24px;
    outline-color: var(--alfred-card-outline-color, #127277);
    outline-offset: 3px;
  }

  .alfred-card-container:hover {
    box-shadow: rgba(0, 0, 0, 0.16) 0px 1rem 2rem -0.75rem;
  }

  .alfred-card-image-container.alfred-card-skeleton {
    width: 100%;
    height: 140px;
    background-repeat: no-repeat;
    background-image: linear-gradient(#deedf2 140px, transparent 0);
    background-size: 100% 100%;
    background-position: top right;
    flex-basis: auto;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
  }

  .alfred-card-text-skeleton {
    min-height: 75px;
  }

  .alfred-card-image-container {
    flex-basis: 40%;
    max-width: 140px;
    flex-shrink: 0;
    margin-bottom: -3px;
  }

  .alfred-card-title-container {
    flex-grow: 1;
  }

  .alfred-card-image {
    width: 100%;
    height: auto;
    display: block;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
  }

  .alfred-card-title {
    text-transform: capitalize;
    color: var(--alfred-card-color, #222);
    font: var(--alfred-card-font);
    box-sizing: border-box;
    padding: 16px;
    text-align: left;
  }

  @media (min-width: 768px) {
    .alfred-card-container {
      flex-direction: column;
      width: 230px;
    }

    .alfred-card-image-container.alfred-card-skeleton {
      width: 100%;
      height: 230px;
      background-color: #deedf2;
      border-bottom-left-radius: 0px;
      border-top-right-radius: 24px;
    }

    .alfred-card-image-container {
      width: 100%;
      max-width: 100%;
    }

    .alfred-card-title-container {
      display: flex;
      align-items: center;
    }

    .alfred-card-title {
      flex-grow: 1;
      text-align: center;
      padding: 24px 8px;
    }

    .alfred-card-image {
      border-bottom-left-radius: 0px;
      border-top-right-radius: 24px;
    }
  }
