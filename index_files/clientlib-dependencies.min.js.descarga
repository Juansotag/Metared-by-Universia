  :host {
    display: block;
    width: 100%;
  }

  .alfred-feedback--hidden {
    display: none;
  }

  .alfred-feedback__container {
    margin: 0 auto;
    width: 100%;
    max-width: 530px;
    box-shadow: 0 5px 8px 0 rgba(0, 0, 0, 0.12);
    border-radius: 16px;
  }

  .alfred-feedback__content {
    box-sizing: border-box;
    padding: 24px 16px 32px 16px;
    text-align: left;
  }

  .alfred-feedback__title {
    font: var(--alfred-feedback-title-font);
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--alfred-feedback-title-color, #222);
    margin: 0 0 16px 0;
  }

  .alfred-feedback__subtitle {
    margin: 8px 0 16px 0;
    font: var(--alfred-feedback-subtitle-font);
    color: var(--alfred-feedback-subtitle-color, #222);
  }

  ::slotted(*) {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
  }

  .alfred-feedback__buttons {
    margin-top: 24px;
    display: flex;
    flex-direction: column-reverse;
  }

  .alfred-feedback__button--primary {
    width: 100%;
    margin-bottom: 16px;
    --argos-button-font: var(--alfred-feedback-button-font);
    --argos-button-border-radius: var(--alfred-feedback-button-border-radius, 50px);
    --argos-button-background-color: var(--alfred-feedback-button-primary-background-color, #ec0000);
    --argos-button-background-color-hover: var(--alfred-feedback-button-primary-background-color-hover, #cc0000);
    --argos-button-color: var(--alfred-feedback-button-primary-color, #fff);
    --argos-button-color-hover: var(--alfred-feedback-button-primary-color-hover, #fff);
  }

  .alfred-feedback__button--secondary {
    width: 100%;
    --argos-button-font: var(--alfred-feedback-button-font);
    --argos-button-border-radius: var(--alfred-feedback-button-border-radius, 50px);
    --argos-button-background-color: var(--alfred-feedback-button-secondary-background-color, #fff);
    --argos-button-background-color-hover: var(--alfred-feedback-button-secondary-background-color-hover, #f6f6f6);
    --argos-button-color: var(--alfred-feedback-button-secondary-color, #ec0000);
    --argos-button-color-hover: var(--alfred-feedback-button-secondary-color-hover, #cc0000);
  }

  .alfred-feedback__buttons--mobile-hidden {
    display: none;
  }

  .alfred-feedback__buttons--desktop-hidden {
    display: flex;
    max-width: 520px;
    margin: 24px auto 0 auto;
  }

  @media (min-width: 768px) {
    .alfred-feedback__content {
      text-align: center;
    }

    .alfred-feedback__buttons {
      margin-top: 32px;
      flex-direction: row;
      justify-content: space-between;
    }

    .alfred-feedback__button--primary {
      margin-bottom: 0;
      margin-left: 24px;
    }

