    width: 220px;
    margin-right: 24px;
  }

  .nav-container > ul {
    list-style: none;
  }

  .nav-container > ul li {
    margin-bottom: 8px;
    position: relative;
  }

  .nav-container > ul li.active .nav-button {
    font: var(--alfred-form-layout-menu-font-active);
  }
  .nav-container > ul li.active:before {
    content: '-';
    color: #ec0000;
    position: absolute;
    left: -10px;
  }

  .nav-button {
    max-width: 210px;
    border: none;
    background-color: white;
    font: var(--alfred-form-layout-menu-font);
    color: var(--alfred-form-layout-menu-color, #222);
    cursor: pointer;
    text-align: left;
    box-sizing: border-box;
