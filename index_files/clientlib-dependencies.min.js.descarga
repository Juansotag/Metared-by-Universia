    font: var(--argos-radio-group-legend-font);
    color: var(--argos-radio-group-legend-color, #222222);
  }

  .argos-radiobutton__box {
    display: flex;
    margin-bottom: 20px;
  }

  .argos-radiobutton__box:last-of-type {
    margin-bottom: 16px;
  }
