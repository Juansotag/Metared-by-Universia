    background-color: var(--argos-tag-background-color-checked, #f5f9fb);
  }

  .argos-tag--disabled {
    background-color: var(--argos-tag-background-color-disabled, #f0f0f0);
    border-color: var(--argos-tag-border-color-disabled, #ccc);
