
  (function (w, l) {
    w[l] = w[l] || [];
    //GTag
    const gTagContainer = document.querySelectorAll('#gTagContainer')[0];
    if (gTagContainer) {
      const gTagKey = gTagContainer.dataset.gtag;
      if(gTagKey) {
        w[l].push(['config', gTagKey]);
      }
    }
    
  })(window,"dataLayer");

