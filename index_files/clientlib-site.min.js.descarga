  :host {
    display: inline-block;
    position: relative;
  }

  * {
    margin: 0;
    padding: 0;
  }

  .argos-loader__container {
    display: flex;
    align-items: center;
    gap: 16px;
    background-color: transparent;
    box-sizing: border-box;
    cursor: wait;
  }

  .argos-loader__container--block {
