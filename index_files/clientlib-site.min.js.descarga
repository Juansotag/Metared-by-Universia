    display: flex;
    align-items: center;
    height: var(--argos-combobox-box-height, 48px);
    border-radius: 8px;
    border: solid 1px var(--argos-combobox-box-border-color, #8f8f8f);
    background-color: var(--argos-combobox-box-background-color, #fff);
    box-sizing: border-box;
