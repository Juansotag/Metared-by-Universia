  :host {
    display: block;
    width: 100%;

    --alfred-form-layout-menu-font: var(--alfred-text-font);
    --alfred-form-layout-menu-font-active: var(--alfred-text-font-strong);
    --alfred-form-button-font: var(--alfred-button-font);
    --alfred-form-field-font: var(--alfred-text-font);
    --alfred-form-field-label-font: var(--alfred-label-font);
    --alfred-form-message-font: var(--alfred-helper-text-font);
    --alfred-form-section-title-font: var(--alfred-text-font-strong);
    --alfred-feedback-title-font: var(--alfred-title-font);
    --alfred-feedback-subtitle-font: var(--alfred-text-font-strong);
    --alfred-feedback-button-font: var(--alfred-button-font);
    --alfred-home-title-font: var(--alfred-text-font-strong);
    --alfred-card-font: var(--alfred-text-font);
  }

  * {
    margin: 0;
    padding: 0;
  }

  header,
  article,
  section {
    display: block;
  }

  .alfred-header {
    text-align: center;
  }

  .alfred-title {
    font: var(--alfred-title-font);
    color: var(--alfred-title-color, #222);
    margin-bottom: 20px;
  }

  .alfred-subtitle {
    font: var(--alfred-text-font);
    color: var(--alfred-text-color, #222);
    margin-bottom: 24px;
  }

  .alfred-subtitle-skeleton {
    height: 20px;
    width: 100%;
    max-width: 540px;
    margin: 0 auto 32px auto;
    background-repeat: repeat-y;
    background-image:
      linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 80%),
      linear-gradient(#f2f2f2 50px, transparent 0);
    background-size:
      50px 200px,
      100% 50%;
    background-position:
      0 0,
      8px 8px;
    animation: shine 1s infinite;
  }

  .alfred-container--error {
    margin-top: 120px;
    text-align: center;
  }

  .alfred-text--error {
    margin-bottom: 24px;
    font: var(--alfred-text-font);
    color: var(--alfred-text-color, #222);
  }

  .alfred-button--error img {
    width: 24px;
  }

  .alfred-button--come-back {
    font: var(--alfred-button-prev-font);
    color: var(--alfred-button-prev-color, #ec0000);
    border: none;
    background-color: transparent;
    margin-bottom: 24px;
    cursor: pointer;
  }

  .alfred-button--come-back img {
    width: 24px;
    vertical-align: middle;
  }

  .alfred-button--come-back span {
    vertical-align: middle;
  }

  @keyframes shine {
    to {
      background-position:
        100% 0,
        8px 8px;
    }
  }

  .alfred-button--error {
    min-width: 200px;

    --argos-button-font: var(--alfred-button-font);
    --argos-button-border-radius: var(--alfred-button-border-radius, 50px);
    --argos-button-background-color: var(--alfred-button-background-color, #ec0000);
    --argos-button-background-color-hover: var(--alfred-button-background-color-hover, #cc0000);
    --argos-button-color: var(--alfred-button-color, #fff);
    --argos-button-color-hover: var(--alfred-button-color-hover, #fff);
  }

  @media (min-width: 768px) {
    .alfred-button--come-back {
      margin-bottom: 12px;
    }
  }
`;window.customElements.get("alfred-feedback")||window.customElements.define("alfred-feedback",Ne),window.customElements.get("alfred-home")||window.customElements.define("alfred-home",ye),window.customElements.get("alfred-form-layout")||window.customElements.define("alfred-form-layout",gr)}()}();