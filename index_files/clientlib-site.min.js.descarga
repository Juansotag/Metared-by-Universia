        tabindex="0"
        @keydown="${this._handleKeyDown}"
        role="${be(this.title?"button":void 0)}"
        aria-label="${this.title}"
      >
        <div
          class="alfred-card-image-container ${pe({"alfred-card-skeleton":!this.imageUrl})}"
        >
          ${this.imageUrl?z` <img aria-hidden="true" class="alfred-card-image" src="${this.imageUrl}" alt="" /> `:z``}
        </div>
        <div
          class="alfred-card-title-container ${pe({"alfred-card-text-skeleton":!this.title})}"
        >
          <p class="alfred-card-title">${this.title}</p>
        </div>
      </div>
    `}static get properties(){return{title:{type:String},imageUrl:{type:String},groupId:{type:String}}}click(e){e.stopPropagation(),this.groupId&&this._emit(me,{detail:this.groupId})}_handleKeyDown(e){[_e.ENTER,_e.SPACE].includes(e.code)&&(e.preventDefault(),this.click(e))}_emit(e,t={}){const o=new CustomEvent(e,{composed:!0,bubbles:!0,...t});this.dispatchEvent(o)}}window.customElements.get("alfred-card")||window.customElements.define("alfred-card",ve);const xe=a`
  :host {
    display: block;
  }

  * {
    padding: 0;
    margin: 0;
  }

  .alfred-home__title {
    font: var(--alfred-home-title-font);
    text-align: center;
    color: var(--alfred-home-title-color, #222);
  }

  .alfred-home__list {
    margin: 72px auto 24px auto;
    list-style-type: none;
    text-align: center;
    max-width: 800px;
  }

  .alfred-home__list-item {
    display: block;
    width: 100%;
    margin-bottom: 16px;
  }

  .alfred-home-title-skeleton {
    height: 20px;
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
    background-repeat: repeat-y;
    background-image:
      linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0) 80%),
      linear-gradient(#deedf2 50px, transparent 0);
    background-size:
      50px 200px,
