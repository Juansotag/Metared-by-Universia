  .nav-container > ul li {
    margin-bottom: 8px;
    position: relative;
  }

  .nav-container > ul li.active .nav-button {
    font: var(--alfred-form-layout-menu-font-active);
  }
  .nav-container > ul li.active:before {
    content: '-';
    color: #ec0000;
    position: absolute;
    left: -10px;
  }

  .nav-button {
    max-width: 210px;
